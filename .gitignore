# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies (no trailing slash: a symlink left by an older scripts/worktree.sh run is ignored too)
node_modules
*.apk
# Expo
.expo/

# local caches (the live catalog built by npm run catalog:live)
.cache/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
