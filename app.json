{
  "expo": {
    "name": "Character Builder",
    "slug": "dnd5e2014CharacterBuilder",
    "version": "2.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/dice-twenty-faces-twenty-red.png",
    "scheme": "dnd5e2014characterbuilder",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#dc2626",
        "foregroundImage": "./assets/images/dice-twenty-faces-twenty.png",
        //"backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/dice-twenty-faces-twenty.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.github.klr2002.cb5e",
      "versionCode": 20101
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/dice-twenty-faces-twenty.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#dc2626",
          "image": "./assets/images/dice-twenty-faces-twenty.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      "expo-web-browser",
      "./plugins/e2e-build.mjs"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d9666891-68f0-45d6-95df-23f06bc7493a"
      }
    },
    "owner": "kl02",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d9666891-68f0-45d6-95df-23f06bc7493a"
    }
  }
}
